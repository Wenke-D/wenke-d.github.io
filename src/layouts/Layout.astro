---
import "../styles/global.css";
import { getEntry } from "astro:content";
import ExternalLink from "../components/ExternalLink.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Blog pages tint the page around a white content column. */
  reading?: boolean;
}

const { lang, title, description, reading = false } = Astro.props;
const profile = (await getEntry("profile", lang))!.data;
// Homepage tab: "Name · Role". Subpages: "Page · Name".
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const desc = description ?? profile.summary;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Runs before first paint: without it a stored dark choice would flash
        the light theme on every navigation. */}
    <script is:inline>
      const stored = localStorage.getItem("theme");
      if (stored === "light" || stored === "night") {
        document.documentElement.dataset.theme = stored;
      }
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body
    class:list={[
      "min-h-screen bg-white text-zinc-800 antialiased dark:bg-zinc-950 dark:text-zinc-200",
      reading && "reading",
    ]}
  >
    <div class="page mx-auto max-w-2xl px-6 py-12 sm:py-16">
      <slot />
      <footer
        class="mt-20 flex flex-wrap items-center justify-between gap-4 border-t border-zinc-200 pt-6 text-sm text-zinc-500 dark:border-zinc-800"
      >
        <p>
          © {new Date().getFullYear()} {profile.name}. Built with{" "}
          <ExternalLink href="https://astro.build">Astro</ExternalLink>.
        </p>
        <ThemeToggle lang={lang} />
      </footer>
    </div>
  </body>
</html>
