---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import { publications } from "../data/publications";
import { ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

function renderAuthors(authors: string): string {
  return authors.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}

// Group by year, newest first.
const byYear = new Map<number, typeof publications>();
for (const p of [...publications].sort((a, b) => b.year - a.year)) {
  byYear.set(p.year, [...(byYear.get(p.year) ?? []), p]);
}

const homeUrl = getRelativeLocaleUrl(lang, "");
---

<Layout lang={lang} title={t.pubsTitle}>
  <a class="text-sm text-accent hover:underline" href={homeUrl}>{t.backHome}</a>
  <h1 class="mt-4 text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white">
    {t.pubsTitle}
  </h1>

  {
    [...byYear.entries()].map(([year, pubs]) => (
      <section class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500">{year}</h2>
        <ul class="mt-3 space-y-6">
          {pubs.map((p) => (
            <li>
              <h3 class="font-medium text-zinc-900 dark:text-white">{p.title}</h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400" set:html={renderAuthors(p.authors)} />
              <p class="text-sm italic text-zinc-500">{p.venue}</p>
              {p.links && (
                <p class="mt-1 flex gap-3 text-sm">
                  {p.links.map((l) => (
                    <a class="text-accent hover:underline" href={l.href}>
                      {l.label}
                    </a>
                  ))}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
