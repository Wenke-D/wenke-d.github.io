---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../i18n";
import type { Post } from "../lib/posts";
import { fullDate } from "../lib/date";

interface Props {
  lang: Lang;
  post: Post;
}

const { lang, post } = Astro.props;
const t = (await getEntry("ui", lang))!.data;
const { Content } = await render(post);
const blogUrl = getRelativeLocaleUrl(lang, "blog");
---

<Layout lang={lang} title={post.data.title} description={post.data.description}>
  <a class="text-sm text-accent hover:underline" href={blogUrl}>{t.backBlog}</a>

  <article class="mt-4">
    <h1 class="text-2xl font-semibold tracking-tight text-balance text-zinc-900 dark:text-white">
      {post.data.title}
    </h1>
    <p class="mt-2 text-sm text-zinc-400">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>
        {fullDate(lang, post.data.date)}
      </time>
    </p>

    <div class="prose mt-8">
      <Content />
    </div>
  </article>
</Layout>
