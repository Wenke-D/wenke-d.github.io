---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import { languages, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  // Page path without locale prefix, e.g. "" for home or "publications".
  path?: string;
}

const { lang, path = "" } = Astro.props;

// Switcher labels ("English", "中文") come from src/content/ui.yaml.
const labels = await getCollection("ui");
const options = languages.map((code) => ({
  code,
  label: labels.find((l) => l.id === code)!.data.label,
}));
---

<nav class="flex justify-end gap-3 text-sm" aria-label="Language">
  {
    options.map(({ code, label }) => (
      <a
        href={getRelativeLocaleUrl(code, path)}
        class={
          code === lang
            ? "font-semibold text-zinc-900 dark:text-white"
            : "text-zinc-400 hover:text-accent"
        }
        aria-current={code === lang ? "page" : undefined}
      >
        {label}
      </a>
    ))
  }
</nav>
