---
import { getEntry } from "astro:content";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (await getEntry("ui", lang))!.data.theme;
---

{/* Two positions, no "system" button: the page follows the OS until the reader
    touches this, and from then on their choice wins — for this tab only. The
    choice lives in sessionStorage, so it survives moving between pages and is
    gone when the tab closes, and the next visit starts from the system again. */}
<fieldset class="theme-switch" aria-label={t.label}>
  <button type="button" data-theme-option="light" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <span class="sr-only">{t.light}</span>
  </button>
  <button type="button" data-theme-option="night" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7.5 7.5 0 1 0 10.5 10.5z" />
    </svg>
    <span class="sr-only">{t.night}</span>
  </button>
</fieldset>

<script>
  const KEY = "theme";
  // sessionStorage, not localStorage: the choice is not meant to outlive the tab.
  const root = document.documentElement;
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-option]");

  /** What the page is actually showing right now. */
  function current(): "light" | "night" {
    const stored = sessionStorage.getItem(KEY);
    if (stored === "light" || stored === "night") return stored;
    return prefersDark.matches ? "night" : "light";
  }

  function mark(theme: string) {
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.themeOption === theme));
    }
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const choice = button.dataset.themeOption!;
      root.dataset.theme = choice;
      sessionStorage.setItem(KEY, choice);
      mark(choice);
    });
  }

  // While the choice is still automatic, keep up with the OS switching at dusk.
  prefersDark.addEventListener("change", () => {
    if (!sessionStorage.getItem(KEY)) mark(current());
  });

  mark(current());
</script>
